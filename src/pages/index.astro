---
import Base from '../layouts/Base.astro';
import {
  event,
  contact,
  tickets,
  programme,
  speakers,
  topics,
  audiences,
  faqs,
  partners,
  partnerMoments,
} from '../data/event.js';

const initials = (name) =>
  name
    .replace(/^(Dr|Mr|Mrs|Ms|Prof|Pharm|Hon|Engr)\.?\s+/i, '')
    .split(/\s+/)
    .map((p) => p[0])
    .slice(0, 2)
    .join('');

const sessionFor = (n) => programme.find((p) => p.session === n);
const sessionTime = (n) => {
  const p = sessionFor(n);
  return p ? `${p.time}–${p.end}` : '';
};
const filledTiers = partners.tiers.filter((t) => t.logos.length);
const openTiers = partners.tiers.filter((t) => ['platinum', 'gold', 'silver'].includes(t.id));
const sessionHref = (n) => `#session-${n}`;
---
<Base
  title="NTC 2.0 · Nigerian Telehealth Conference · 20 Oct 2026, Abuja"
  description="The Nigerian Telehealth Conference returns to Abuja on 20 October 2026. Policy, financing and community adoption of telehealth, plus the Gala & Awards Night. In person at AATC and online."
>
  <header class="nav" id="top">
    <div class="wrap nav__inner">
      <a href="#top" class="mark" aria-label="NTC 2.0 home">
        <svg class="mark__signal" viewBox="0 0 24 16" aria-hidden="true">
          <path d="M3 9a13 13 0 0 1 18 0M7 12.5a7.5 7.5 0 0 1 10 0" />
          <circle cx="12" cy="14.6" r="1.6" />
        </svg>
        <span class="mark__ntc">NTC</span><span class="mark__ver">2.0</span>
      </a>
      <nav class="nav__links" aria-label="Main">
        <a href="#about">About</a>
        <a href="#programme">Programme</a>
        <a href="#speakers">Speakers</a>
        <a href="#gala">Gala</a>
        <a href="#partners">Partners</a>
        <a href="#venue">Venue</a>
      </nav>
      <a class="btn btn--small" href="#tickets">Get a ticket</a>
    </div>
  </header>

  <main>
    <!-- HERO -->
    <section class="hero">
      <canvas class="hero__net" aria-hidden="true"></canvas>
      <div class="wrap hero__grid">
        <div class="hero__copy">
          <p class="eyebrow eyebrow--light rise" style="--d:0">Nigerian Telehealth Conference · Second edition</p>
          <h1 class="hero__title rise" style="--d:1">
            The future of healthcare is connected.
            <span class="hero__accent"><span class="click">Click</span> <span class="amp">&amp;</span> <span class="brick">Brick</span><span class="hero__link" aria-hidden="true"><i></i></span></span>
          </h1>
          <p class="hero__lede rise" style="--d:2">
            One day in Abuja to move telehealth from pilots and policy papers to something every Nigerian can use.
            Regulators, payers, providers, funders and founders, in one room and online.
          </p>
          <div class="hero__ctas rise" style="--d:3">
            <a class="btn" href="#tickets">Get a ticket <span class="arr">→</span></a>
            <a class="btn btn--ghost" href="#programme">See the programme</a>
          </div>
        </div>

        <aside class="stub rise" style="--d:2" aria-label="Event details">
          <div class="stub__date">
            <span class="stub__day">20</span>
            <span class="stub__month">Oct<br />2026</span>
          </div>
          <p class="stub__weekday">Tuesday</p>
          <dl class="stub__facts">
            <div><dt>Where</dt><dd>AATC, Central Business District, Abuja</dd></div>
            <div><dt>Conference</dt><dd>{event.conferenceHours}</dd></div>
            <div><dt>Gala & Awards</dt><dd>{event.galaHours}</dd></div>
            <div><dt>Format</dt><dd>{event.format}</dd></div>
          </dl>
          <div class="stub__perf" aria-hidden="true"></div>
          <div class="countdown" data-countdown={event.startISO} aria-live="off">
            <div><span data-unit="d">--</span><small>days</small></div>
            <div><span data-unit="h">--</span><small>hours</small></div>
            <div><span data-unit="m">--</span><small>mins</small></div>
            <div><span data-unit="s">--</span><small>secs</small></div>
          </div>
        </aside>
      </div>

      <div class="wrap">
        <ul class="facts rise" style="--d:4">
          <li><strong data-count={event.capacity.physical}>{event.capacity.physical}</strong> delegates in the room</li>
          <li><strong data-count={event.capacity.virtual}>{event.capacity.virtual}</strong> joining online</li>
          <li><strong data-count="8">8</strong> sessions, one day</li>
          <li><strong>1</strong> Abuja Declaration on Telehealth</li>
        </ul>
      </div>
      <div class="waves" aria-hidden="true">
        <svg class="waves__layer waves__layer--sky" viewBox="0 0 2880 120" preserveAspectRatio="none"><path d="M0 60C360 0 1080 120 1440 60S2520 0 2880 60V120H0Z" /></svg>
        <svg class="waves__layer waves__layer--green" viewBox="0 0 2880 120" preserveAspectRatio="none"><path d="M0 70C360 10 1080 130 1440 70S2520 10 2880 70V120H0Z" /></svg>
      </div>
    </section>

    <div class="ticker" aria-hidden="true">
      <div class="ticker__track">
        {[0, 1].map(() => (
          <span class="ticker__set">
            {['20 October 2026', 'AATC, Abuja', 'Click & Brick', '#NTC2026', 'In person & online', '#TelehealthForAll', 'Abuja Declaration on Telehealth', '#ClickAndBrick'].map((t) => (
              <span class="ticker__item">{t}<b class="ticker__dot"></b></span>
            ))}
          </span>
        ))}
      </div>
    </div>

    <!-- ABOUT / CLICK & BRICK -->
    <section class="section" id="about">
      <div class="wrap">
        <p class="eyebrow">The idea</p>
        <h2 class="h2">Telehealth works when the screen<br class="br-wide" /> and the building work together.</h2>

        <div class="cb">
          <div class="cb__col">
            <p class="cb__label cb__label--click">Click</p>
            <p>The phone call, the video consultation, the e-prescription, the medical record that follows the patient from one clinic to the next.</p>
          </div>
          <div class="cb__join" aria-hidden="true">
            <svg viewBox="0 0 80 200" preserveAspectRatio="none">
              <line x1="40" y1="0" x2="40" y2="200" />
              <circle cx="40" cy="40" r="5" /><circle cx="40" cy="100" r="9" /><circle cx="40" cy="160" r="5" />
              <circle class="cb__pulse" cx="40" cy="0" r="4"><animate attributeName="cy" values="0;200" dur="2.6s" repeatCount="indefinite" /><animate attributeName="opacity" values="0;1;1;0" dur="2.6s" repeatCount="indefinite" /></circle>
            </svg>
          </div>
          <div class="cb__col">
            <p class="cb__label cb__label--brick">Brick</p>
            <p>The primary health centre, the pharmacy counter, the market kiosk, the hospital bed. The places people already walk into and trust.</p>
          </div>
        </div>

        <div class="about__grid">
          <div class="about__text">
            <p>
              The first Nigerian Telehealth Conference set out what the country needed to make telehealth part of everyday care.{' '}
              <strong>NTC 2.0 asks what has moved since, and who will move the rest.</strong>
            </p>
            <p>
              The day is built around commitments, not speeches. Every panel closes with each speaker naming one thing their
              institution will deliver, and by when. Those commitments go into the <strong>Abuja Declaration on Telehealth</strong>,
              read at the closing plenary.
            </p>
            <p class="focus"><span>Focus</span> {event.focus}</p>
          </div>

          <figure class="stat">
            <p class="stat__num"><span data-count="30">30</span>%</p>
            <figcaption>
              of people who used a telehealth kiosk in Lagos said they <strong>would not have sought care at all</strong> without it.
              <span class="stat__src">Source: VillageReach, Lagos Telehealth Case Study, 2026</span>
            </figcaption>
          </figure>
        </div>
      </div>
    </section>

    <!-- TOPICS -->
    <section class="section section--green">
      <div class="wrap topics">
        <div>
          <p class="eyebrow">On the table</p>
          <h2 class="h2">The questions that decide whether telehealth scales.</h2>
        </div>
        <ol class="topics__list">
          {topics.map((t, i) => (
            <li><span class="topics__n">{String(i + 1).padStart(2, '0')}</span>{t}</li>
          ))}
        </ol>
      </div>
    </section>

    <!-- PROGRAMME -->
    <section class="section" id="programme">
      <div class="wrap">
        <div class="section__head">
          <div>
            <p class="eyebrow">Programme</p>
            <h2 class="h2">Tuesday, 20 October</h2>
          </div>
          <p class="section__note">All times West Africa Time (WAT). Working draft; sessions may move.</p>
        </div>

        <ol class="agenda">
          {programme.map((item) => (
            <li id={item.session ? `session-${item.session}` : undefined} class={`agenda__row ${item.kind ? `agenda__row--${item.kind}` : ''}`}>
              <p class="agenda__time">{item.time}<span>–{item.end}</span></p>
              <div class="agenda__body">
                {item.session && <p class="agenda__tag">Session {item.session}</p>}
                <h3 class="agenda__title">{item.title}</h3>
                {item.sub && <p class="agenda__sub">{item.sub}</p>}
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- SPEAKERS -->
    <section class="section section--tint" id="speakers">
      <div class="wrap">
        <div class="section__head">
          <div>
            <p class="eyebrow">Speakers</p>
            <h2 class="h2">Who's on stage</h2>
          </div>
          <p class="section__note">
            <span class="count-pill"><b>{speakers.length}</b> confirmed</span>
            Ministers, regulators, insurers and funders have been invited. Badges go up here as they confirm.
          </p>
        </div>

        <ul class="badges">
          {speakers.map((s) => (
            <li class={`badge badge--${s.type.toLowerCase()}`}>
              <span class="badge__slot" aria-hidden="true"></span>
              <p class="badge__band">{s.type}</p>
              <div class="badge__photo">
                {s.photo ? (
                  <img src={s.photo} alt={s.name} loading="lazy" width="320" height="320" />
                ) : (
                  <span aria-hidden="true">{initials(s.name)}</span>
                )}
              </div>
              <h3 class="badge__name">{s.name}</h3>
              <p class="badge__role">{s.role}</p>
              <p class="badge__org">{s.org}</p>
              {s.session ? (
                <a class="chip" href={sessionHref(s.session)}>
                  <span>{sessionTime(s.session)}</span> {sessionFor(s.session)?.short}
                </a>
              ) : (
                <p class="chip chip--muted">Session to be announced</p>
              )}
              <p class="badge__foot" aria-hidden="true">NTC 2.0 · 20.10.26</p>
            </li>
          ))}
        </ul>
        <div class="next-up">
          <p class="next-up__label"><span class="next-up__dot" aria-hidden="true"></span>More speakers soon</p>
          <p class="next-up__text">
            New confirmations go up on Instagram first:{' '}
            <a href={contact.instagram[0].url} target="_blank" rel="noopener">{contact.instagram[0].handle}</a>
          </p>
          <a class="btn btn--outline btn--small" href={`mailto:${contact.partnerships}?subject=NTC%202.0%20speaking`}>Want to speak? Get in touch</a>
        </div>
      </div>
    </section>

    <!-- GALA -->
    <section class="gala" id="gala">
      <div class="gala__sparkle" aria-hidden="true"></div>
      <div class="wrap gala__inner">
        <div>
          <p class="eyebrow eyebrow--gold">Same evening · {event.galaHours}</p>
          <h2 class="h2 h2--light">NTC 2.0 Gala &amp; Awards Night</h2>
          <p class="gala__text">
            An evening for the people doing the work: recognising excellence in telehealth, digital health, innovation,
            partnerships and healthcare leadership, and crowning the winners of the Student Innovation Challenge.
          </p>
          <p class="gala__text gala__text--small">Award categories and nominations will be announced on our Instagram.</p>
        </div>
        <a class="btn btn--gold" href="#tickets">Get a Conference + Awards Night ticket</a>
      </div>
    </section>

    <!-- TICKETS -->
    <section class="section" id="tickets">
      <div class="wrap">
        <div class="section__head">
          <div>
            <p class="eyebrow">Tickets</p>
            <h2 class="h2">Choose how you'll join</h2>
          </div>
          <p class="section__note">Booked securely through tix.africa. Prices include booking fees.</p>
        </div>

        <ul class="tickets">
          {tickets.map((t) => (
            <li class={`ticket ${t.featured ? 'ticket--featured' : ''}`}>
              <h3 class="ticket__name">{t.name}</h3>
              <p class="ticket__price">{t.price}</p>
              <p class="ticket__note">{t.note}</p>
              <ul class="ticket__includes">
                {t.includes.map((x) => <li>{x}</li>)}
              </ul>
              <a class={`btn ${t.featured ? '' : 'btn--outline'}`} href={event.ticketUrl} target="_blank" rel="noopener">
                Book on tix.africa
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- PARTNERS -->
    <section class="section partners" id="partners">
      <div class="wrap">
        <div class="section__head">
          <div>
            <p class="eyebrow">Partners</p>
            <h2 class="h2">Put your name behind<br class="br-wide" /> nationwide telehealth.</h2>
          </div>
          <p class="section__note">
            NTC 2.0 brings together the people who decide how care reaches Nigerians. Partner with us to be in the room,
            on stage and in the conversation.
          </p>
        </div>

        <p class="convened">
          <span>Convened by</span>
          {partners.convener.logo ? (
            <img src={partners.convener.logo} alt={partners.convener.name} height="40" />
          ) : (
            <strong>{partners.convener.name}</strong>
          )}
        </p>

        {filledTiers.length ? (
          <div class="tierwall">
            {filledTiers.map((t) => (
              <div class={`tier tier--${t.id}`}>
                <p class="tier__label">{t.label}{t.blurb && ['platinum', 'gold', 'silver'].includes(t.id) ? ' partners' : ''}</p>
                <ul class="tier__logos">
                  {t.logos.map((l) => (
                    <li>
                      <a class="logo-tile" href={l.url || undefined} target="_blank" rel="noopener" title={l.name}>
                        <img src={l.logo} alt={l.name} loading="lazy" />
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        ) : (
          <ul class="slots">
            {openTiers.map((t) => (
              <li class={`slot slot--${t.id}`}>
                <p class="slot__status"><span class="slot__dot" aria-hidden="true"></span>Open</p>
                <h3 class="slot__tier">{t.label}</h3>
                <p class="slot__blurb">{t.blurb}</p>
                <div class="slot__logo" aria-hidden="true"><span>Your logo here</span></div>
              </li>
            ))}
          </ul>
        )}

        <div class="moments">
          <div class="moments__head">
            <h3 class="moments__title">Where partners show up on the day</h3>
            <p class="moments__sub">Tuesday 20 October · from registration to the last award</p>
          </div>
          <ol class="moments__track">
            {partnerMoments.map((m) => (
              <li class="moment">
                <span class="moment__dot" aria-hidden="true"></span>
                <p class="moment__time">{m.time}</p>
                <h4 class="moment__title">{m.title}</h4>
                <p class="moment__text">{m.text}</p>
              </li>
            ))}
          </ol>
        </div>

        <div class="reach">
          <div class="reach__numbers">
            <p><strong data-count={event.capacity.physical}>{event.capacity.physical}</strong> delegates in Abuja</p>
            <p><strong data-count={event.capacity.virtual}>{event.capacity.virtual}</strong> joining online</p>
          </div>
          <div class="reach__who">
            <p class="reach__label">Who's in the room</p>
            <ul class="tags">
              {audiences.map((a) => <li>{a}</li>)}
            </ul>
          </div>
          <div class="reach__cta">
            <h3 class="h3">Let's talk</h3>
            <p>Tell us what you want to achieve and we'll send the partnership options that fit.</p>
            <a class="btn" href={`mailto:${contact.partnerships}?subject=NTC%202.0%20partnership`}>Email the partnerships team <span class="arr">→</span></a>
            <p class="reach__contact">{contact.partnerships} · <a href={contact.phoneHref}>{contact.phone}</a></p>
          </div>
        </div>
      </div>
    </section>

    <!-- VENUE -->
    <section class="section" id="venue">
      <div class="wrap venue">
        <div>
          <p class="eyebrow">Venue</p>
          <h2 class="h2">{event.venue.name}</h2>
          <p class="venue__addr">{event.venue.address}</p>
          <a class="btn btn--outline" href={event.venue.mapUrl} target="_blank" rel="noopener">Open in Google Maps</a>
        </div>
        <dl class="venue__facts">
          <div><dt>Date</dt><dd>{event.dateLabel}</dd></div>
          <div><dt>Registration opens</dt><dd>7:30 AM</dd></div>
          <div><dt>Conference</dt><dd>{event.conferenceHours}</dd></div>
          <div><dt>Gala & Awards Night</dt><dd>{event.galaHours}</dd></div>
        </dl>
      </div>
    </section>

    <!-- FAQ -->
    <section class="section section--tint" id="faq">
      <div class="wrap faq">
        <div>
          <p class="eyebrow">Questions</p>
          <h2 class="h2">Good to know</h2>
        </div>
        <div class="faq__list">
          {faqs.map((f) => (
            <details>
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>
  </main>

  <footer class="footer">
    <div class="wrap footer__grid">
      <div>
        <a href="#top" class="mark mark--light" aria-label="Back to top">
          <svg class="mark__signal" viewBox="0 0 24 16" aria-hidden="true">
            <path d="M3 9a13 13 0 0 1 18 0M7 12.5a7.5 7.5 0 0 1 10 0" />
            <circle cx="12" cy="14.6" r="1.6" />
          </svg>
          <span class="mark__ntc">NTC</span><span class="mark__ver">2.0</span>
        </a>
        <p class="footer__tag">{event.tagline}</p>
        <p class="footer__small">Convened by Mobihealth International.</p>
      </div>
      <div>
        <h3 class="footer__h">Contact</h3>
        <p><a href={contact.phoneHref}>{contact.phone}</a></p>
        <p><a href={`mailto:${contact.support}`}>{contact.support}</a></p>
        <p><a href={`mailto:${contact.partnerships}`}>{contact.partnerships}</a> <span class="footer__small">(partnerships)</span></p>
      </div>
      <div>
        <h3 class="footer__h">Follow</h3>
        {contact.instagram.map((i) => (
          <p><a href={i.url} target="_blank" rel="noopener">{i.handle}</a></p>
        ))}
        <p class="footer__small">{contact.hashtags.join('  ')}</p>
      </div>
    </div>
  </footer>

  <a class="mobile-cta" href="#tickets">Get a ticket · from ₦15,000</a>

  <script>
    import '../scripts/motion.js';
  </script>
</Base>
