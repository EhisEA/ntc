---
import Base from '../layouts/Base.astro';
import {
  event,
  contact,
  tickets,
  programme,
  speakers,
  topics,
  audiences,
  faqs,
  partners,
  partnerMoments,
  journey,
  reels,
} from '../data/event.js';
import { initials, sessionFor, sessionTime, sessionHref } from '../lib/helpers.js';
import DesignSwitch from '../components/DesignSwitch.astro';
import '../styles/global.css';

const filledTiers = partners.tiers.filter((t) => t.logos.length);
const openTiers = partners.tiers.filter((t) => ['platinum', 'gold', 'silver'].includes(t.id));

// colour of each timetable cell
const slotKind = (item) => {
  if (item.kind) return item.kind;
  if (item.session === 1 || item.session === 8) return 'plenary';
  if (item.session === 2) return 'panel';
  if (item.session === '6–7') return 'youth';
  return 'fireside';
};

// hero bricks: [left %, width px, height px, colour, delay index]
const bricks = [
  [0, 120, 150, 'navy', 0], [8, 70, 90, 'lime', 3], [13, 150, 210, 'green', 1], [24, 90, 120, 'white', 5],
  [30, 130, 70, 'sky', 7], [39, 80, 170, 'navy', 2], [45, 160, 100, 'lime', 6], [57, 90, 230, 'green', 4],
  [64, 120, 130, 'sky', 8], [73, 70, 80, 'white', 9], [78, 140, 190, 'navy', 3], [88, 120, 110, 'green', 6],
];
const floaters = [
  [6, 18, 64, 64, 'sky'], [86, 14, 80, 120, 'lime'], [92, 46, 54, 54, 'green'], [3, 52, 44, 80, 'white'],
];

// running-bond brick wall for the Brick illustration: [x, y, width, row]
const wall = [0, 1, 2, 3, 4, 5].flatMap((row) => {
  const y = 196 - row * 22;
  const spans = row % 2
    ? [[36, 19], [57, 40], [99, 40], [141, 40], [183, 19]]
    : [[36, 40], [78, 40], [120, 40], [162, 40]];
  return spans.map(([x, w]) => [x, y, w, row]);
});

// simple line icons for the seven topics
const topicIcons = [
  // guidelines: document with tick
  '<rect x="14" y="8" width="36" height="48" rx="4"/><path d="M22 20h20M22 28h20M22 36h10"/><circle cx="44" cy="46" r="9" class="fill"/><path d="M40 46l3 3 5-6" class="ink"/>',
  // insurance: shield with cross
  '<path d="M32 8l20 8v14c0 13-9 22-20 26-11-4-20-13-20-26V16z"/><path d="M32 22v16M24 30h16" class="ink"/><circle cx="32" cy="30" r="13" class="fill" />',
  // legislation: columns
  '<path d="M10 22L32 10l22 12z" class="fill"/><path d="M10 22L32 10l22 12M14 26v20M24 26v20M40 26v20M50 26v20M8 52h48"/>',
  // AI & data: chip with lock
  '<rect x="16" y="16" width="32" height="32" rx="5"/><path d="M24 10v6M32 10v6M40 10v6M24 48v6M32 48v6M40 48v6M10 24h6M10 40h6M48 24h6M48 40h6"/><rect x="25" y="30" width="14" height="11" rx="2" class="fill"/><path d="M28 30v-3a4 4 0 0 1 8 0v3"/>',
  // financing: coin stack
  '<ellipse cx="28" cy="44" rx="16" ry="6"/><path d="M12 44v-8c0 3 7 6 16 6s16-3 16-6v8"/><ellipse cx="28" cy="36" rx="16" ry="6" class="fill"/><path d="M12 28v8M44 28v8"/><ellipse cx="28" cy="28" rx="16" ry="6"/><circle cx="48" cy="18" r="9" class="fill"/><path d="M45 22v-8l6 8v-8" class="ink"/>',
  // PHC: clinic
  '<path d="M10 30L32 14l22 16"/><rect x="16" y="28" width="32" height="26" class="fill"/><path d="M32 34v12M26 40h12" class="ink"/><path d="M8 54h48"/>',
  // workforce: cap
  '<path d="M6 26l26-12 26 12-26 12z" class="fill"/><path d="M16 31v12c0 4 7 8 16 8s16-4 16-8V31M54 27v14"/>',
];
---
<Base
  title="NTC 2.0 · Nigerian Telehealth Conference · 20 Oct 2026, Abuja"
  description="The Nigerian Telehealth Conference returns to Abuja on 20 October 2026. Policy, financing and community adoption of telehealth, plus the Gala & Awards Night. In person at AATC and online."
>
  <header class="nav" id="top">
    <div class="wrap nav__inner">
      <a href="#top" class="mark" aria-label="NTC 2.0 home">
        <svg class="mark__signal" viewBox="0 0 24 16" aria-hidden="true">
          <path d="M3 9a13 13 0 0 1 18 0M7 12.5a7.5 7.5 0 0 1 10 0" />
          <circle cx="12" cy="14.6" r="1.6" />
        </svg>
        <span class="mark__ntc">NTC</span><span class="mark__ver">2.0</span>
      </a>
      <nav class="nav__links" aria-label="Main">
        <a href="#about">About</a>
        <a href="#programme">Programme</a>
        <a href="#speakers">Speakers</a>
        <a href="#gala">Gala</a>
        <a href="#partners">Partners</a>
        <a href="#venue">Venue</a>
      </nav>
      <a class="btn btn--small" href="#tickets"><span class="btn__label">Get tickets</span><span class="btn__arr" aria-hidden="true">→</span></a>
    </div>
  </header>

  <main>
    <!-- HERO: signal rings (click) over stacking bricks (brick) -->
    <section class="hero">
      <svg class="hero__rings" viewBox="0 0 1600 900" preserveAspectRatio="xMidYMax slice" aria-hidden="true">
        {[140, 260, 380, 500, 620, 740, 860, 980].map((r) => (
          <circle cx="800" cy="900" r={r} />
        ))}
        <circle class="hero__pulse" cx="800" cy="900" r="140" />
        <circle class="hero__pulse hero__pulse--2" cx="800" cy="900" r="140" />
      </svg>

      {floaters.map(([l, t, w, h, c], i) => (
        <span class={`floater brick--${c}`} style={`left:${l}%;top:${t}%;width:${w}px;height:${h}px;--i:${i}`} aria-hidden="true"></span>
      ))}

      <div class="wrap hero__inner">
        <div class="hero__copy">
        <p class="hero__kicker rise" style="--d:0">Nigerian Telehealth Conference · 2nd edition</p>
        <p class="hero__date rise" style="--d:1">{event.dateLabel} · Abuja</p>
        <h1 class="hero__title rise" style="--d:2">
          <span class="hero__pre">The future of healthcare is connected</span>
          <span class="hero__big"><span class="click">Click</span> <span class="amp">&amp;</span> <span class="brick">Brick</span></span>
        </h1>
        <div class="hero__ctas rise" style="--d:3">
          <a class="btn" href="#tickets"><span class="btn__label">Get tickets</span><span class="btn__arr" aria-hidden="true">→</span></a>
          <a class="btn btn--white" href="#partners"><span class="btn__label">Become a partner</span><span class="btn__arr" aria-hidden="true">→</span></a>
        </div>
        </div>

        <div class="scene rise" style="--d:3">
          <figure class="scene__main">
            <img src="/media/nurse-tablet.webp" alt="A health worker connects a patient to a doctor by video call on a tablet" width="900" height="900" fetchpriority="high" />
            <span class="scene__tag scene__tag--click"><i></i>Click · video consultation</span>
          </figure>
          <figure class="scene__inset">
            <img src="/media/health-centre.webp" alt="A primary health centre" width="1024" height="571" />
            <span class="scene__tag scene__tag--brick">Brick · health centre</span>
          </figure>
          <svg class="scene__link" viewBox="0 0 200 160" aria-hidden="true">
            <path id="scene-path" d="M20 20 C 120 10, 60 140, 180 140" />
            <circle r="7"><animateMotion dur="2.4s" repeatCount="indefinite"><mpath href="#scene-path" /></animateMotion></circle>
          </svg>
        </div>
      </div>

      <div class="hero__bricks" aria-hidden="true">
        {bricks.map(([l, w, h, c, d]) => (
          <span class={`brick brick--${c}`} style={`left:${l}%;width:${w}px;height:${h}px;--d:${d}`}></span>
        ))}
      </div>
    </section>

    <!-- INFO BAR -->
    <section class="infobar">
      <div class="wrap">
        <p class="infobar__line">
          {event.dateLabel.replace('Tuesday, ', '')}.<br />
          Afreximbank African Trade Centre, Abuja.
        </p>
      </div>
      <div class="infobar__grid">
        <div class="infobar__cell infobar__cell--count">
          <p class="infobar__label">Starts in</p>
          <div class="countdown" data-countdown={event.startISO}>
            <div><span data-unit="d">--</span><small>days</small></div>
            <div><span data-unit="h">--</span><small>hrs</small></div>
            <div><span data-unit="m">--</span><small>mins</small></div>
            <div><span data-unit="s">--</span><small>secs</small></div>
          </div>
        </div>
        <div class="infobar__cell"><strong data-count={event.capacity.physical}>{event.capacity.physical}</strong><span>delegates in the room</span></div>
        <div class="infobar__cell"><strong data-count={event.capacity.virtual}>{event.capacity.virtual}</strong><span>joining online</span></div>
        <div class="infobar__cell"><strong data-count="8">8</strong><span>sessions, one day</span></div>
        <div class="infobar__cell"><strong>1</strong><span>Abuja Declaration on Telehealth</span></div>
      </div>
    </section>

    <!-- CLICK & BRICK -->
    <section class="cbw" id="about">
      <div class="cbw__half cbw__half--click">
        <div class="cbw__copy">
          <p class="cbw__word">Click</p>
          <p>The phone call, the video consultation, the e-prescription, the record that follows the patient from clinic to clinic.</p>
        </div>
        <figure class="cbw__photo">
          <img src="/media/doctor-video-call.webp" alt="A doctor on a video consultation with a patient" width="900" height="900" loading="lazy" />
        </figure>
      </div>
      <div class="cbw__amp" aria-hidden="true"><span>&amp;</span></div>
      <div class="cbw__half cbw__half--brick">
        <figure class="cbw__photo">
          <img src="/media/health-centre.webp" alt="A primary health centre with patients arriving" width="1024" height="571" loading="lazy" />
        </figure>
        <div class="cbw__copy">
          <p class="cbw__word">Brick</p>
          <p>The primary health centre, the pharmacy counter, the market kiosk, the hospital bed. The places people already walk into and trust.</p>
        </div>
      </div>
    </section>

    <!-- JOURNEY: what telehealth looks like for one patient -->
    <section class="journey" id="journey">
      <div class="wrap">
        <div class="section__head section__head--light">
          <div>
            <p class="eyebrow eyebrow--lime">How telehealth works</p>
            <h2 class="display display--light">One patient.<br />One connected journey.</h2>
          </div>
          <p class="section__note">A Nigeria where everyone can reach the right care, wherever they are. This is what NTC 2.0 is working to make normal.</p>
        </div>
        <div class="journey__grid">
          <figure class="journey__photo">
            <img src="/media/phone-abuja.webp" alt="A young woman uses her phone to reach a doctor, with Abuja behind her" width="1024" height="571" loading="lazy" />
            <figcaption><span class="journey__live"></span>Doctor available</figcaption>
          </figure>
          <ol class="path">
            {journey.map((step, i) => (
              <li class={`path__step path__step--${step.kind}`}>
                <span class="path__node" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                <div>
                  <p class="path__kind">{step.kind === 'both' ? 'Click + Brick' : step.kind === 'click' ? 'Click' : 'Brick'}</p>
                  <h3 class="path__title">{step.title}</h3>
                  <p class="path__text">{step.text}</p>
                </div>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </section>

    <section class="why">
      <div class="wrap why__grid">
        <div class="why__text">
          <p class="eyebrow">Why NTC 2.0</p>
          <h2 class="display">From policy<br />to practice.</h2>
          <p>
            The first Nigerian Telehealth Conference set out what the country needed to make telehealth part of everyday care.{' '}
            <strong>NTC 2.0 asks what has moved since, and who will move the rest.</strong>
          </p>
          <p>
            The day runs on commitments, not speeches. Every panel closes with each speaker naming one thing their institution
            will deliver, and by when. Those commitments become the <strong>Abuja Declaration on Telehealth</strong>, read at
            the closing plenary.
          </p>
        </div>
        <figure class="bigstat">
          <p class="bigstat__num"><span data-count="30">30</span>%</p>
          <figcaption>
            of people who used a telehealth kiosk in Lagos said they <strong>would not have sought care at all</strong> without it.
            <span>VillageReach, Lagos Telehealth Case Study, 2026</span>
          </figcaption>
        </figure>
      </div>
    </section>

    <!-- FILM: real footage from NTC 2025 and Mobihealth in the community -->
    <section class="film" id="film">
      <div class="wrap">
        <div class="section__head">
          <div>
            <p class="eyebrow">On film</p>
            <h2 class="display">Telehealth,<br />on the ground.</h2>
          </div>
          <p class="section__note">NTC 2.0 builds on NTC 2025 and on years of telehealth work in Nigerian communities. Press play.</p>
        </div>
        <div class="film__grid">
          {reels.map((r) => (
            <figure class={`reel reel--${r.shape}`}>
              <video controls preload="none" playsinline poster={r.poster} width={r.w} height={r.h}>
                <source src={r.src} type="video/mp4" />
              </video>
              <figcaption><strong>{r.title}</strong>{r.caption}</figcaption>
            </figure>
          ))}
        </div>
        <p class="film__more">
          More on Instagram:{' '}
          {contact.instagram.map((ig, i) => (
            <>{i > 0 && ' · '}<a href={ig.url} target="_blank" rel="noopener">{ig.handle}</a></>
          ))}
        </p>
      </div>
    </section>

    <!-- TOPICS: boxed grid like a poster -->
    <section class="tracks">
      <div class="wrap">
        <div class="tracks__head">
          <p class="tracks__num" data-count={topics.length}>{topics.length}</p>
          <h2 class="display display--center">Questions on the table</h2>
        </div>
        <ul class="tracks__grid">
          {topics.map((t, i) => (
            <li class="track">
              <p class="track__n">{String(i + 1).padStart(2, '0')}</p>
              <h3 class="track__title">{t}</h3>
              <svg class="track__icon" viewBox="0 0 64 64" aria-hidden="true" set:html={topicIcons[i]} />
            </li>
          ))}
          <li class="track track--cta">
            <a href="#tickets">
              <span class="track__title">Be in the room when it's decided</span>
              <span class="track__go">Get tickets →</span>
            </a>
          </li>
        </ul>
      </div>
    </section>

    <!-- PROGRAMME: colour-coded timetable -->
    <section class="sched" id="programme">
      <div class="wrap">
        <div class="sched__head">
          <h2 class="display">The day</h2>
          <div>
            <p class="sched__date">{event.dateLabel}</p>
            <p class="sched__note">All times WAT. Working draft; sessions may move.</p>
          </div>
        </div>

        <ol class="tt">
          {programme.map((item) => (
            <li id={item.session ? `session-${item.session}` : undefined} class={`tt__row tt__row--${slotKind(item)}`}>
              <p class="tt__time">{item.time}<span>–{item.end}</span></p>
              <div class="tt__cell">
                {item.session && <p class="tt__tag">Session {item.session}</p>}
                <h3 class="tt__title">{item.title}</h3>
                {item.sub && <p class="tt__sub">{item.sub}</p>}
              </div>
            </li>
          ))}
        </ol>

        <ul class="legend" aria-label="Key">
          <li class="legend--plenary">Plenary</li>
          <li class="legend--panel">Leadership panel</li>
          <li class="legend--fireside">Fireside chat</li>
          <li class="legend--youth">Youth & innovation</li>
          <li class="legend--gala">Gala</li>
        </ul>
      </div>
    </section>

    <!-- SPEAKERS -->
    <div class="ticker ticker--navy" aria-hidden="true">
      <div class="ticker__track">
        {[0, 1].map(() => (
          <span class="ticker__set">
            {[0, 1, 2, 3].map(() => <span class="ticker__item">Meet the speakers<b class="ticker__dot"></b></span>)}
          </span>
        ))}
      </div>
    </div>

    <section class="speakers-world" id="speakers">
      <div class="wrap">
        <div class="section__head section__head--light">
          <div>
            <p class="count-pill"><b>{speakers.length}</b> confirmed</p>
            <h2 class="display display--light">Who's on stage</h2>
          </div>
          <p class="section__note">Ministers, regulators, insurers and funders have been invited. Badges go up here as they confirm.</p>
        </div>

        <ul class="badges">
          {speakers.map((s) => (
            <li class={`badge badge--${s.type.toLowerCase()}`}>
              <span class="badge__slot" aria-hidden="true"></span>
              <p class="badge__band">{s.type}</p>
              <div class="badge__photo">
                {s.photo ? (
                  <img src={s.photo} alt={s.name} loading="lazy" width="320" height="320" />
                ) : (
                  <span aria-hidden="true">{initials(s.name)}</span>
                )}
              </div>
              <h3 class="badge__name">{s.name}</h3>
              <p class="badge__role">{s.role}</p>
              <p class="badge__org">{s.org}</p>
              {s.session ? (
                <a class="chip" href={sessionHref(s.session)}>
                  <span>{sessionTime(s.session)}</span> {sessionFor(s.session)?.short}
                </a>
              ) : (
                <p class="chip chip--muted">Session to be announced</p>
              )}
              <p class="badge__foot" aria-hidden="true">NTC 2.0 · 20.10.26</p>
            </li>
          ))}
        </ul>

        <div class="next-up">
          <p class="next-up__label"><span class="next-up__dot" aria-hidden="true"></span>More speakers soon</p>
          <p class="next-up__text">
            New confirmations go up on Instagram first:{' '}
            <a href={contact.instagram[0].url} target="_blank" rel="noopener">{contact.instagram[0].handle}</a>
          </p>
          <a class="btn btn--white btn--small" href={`mailto:${contact.partnerships}?subject=NTC%202.0%20speaking`}><span class="btn__label">Want to speak?</span><span class="btn__arr" aria-hidden="true">→</span></a>
        </div>
      </div>
    </section>

    <!-- GALA: gold rays -->
    <section class="gala" id="gala">
      <div class="gala__rays" aria-hidden="true"></div>
      <div class="gala__sparkle" aria-hidden="true"></div>
      <div class="wrap gala__inner">
        <p class="gala__time">Same evening · {event.galaHours}</p>
        <h2 class="gala__title">Gala &amp; Awards Night</h2>
        <p class="gala__text">
          An evening for the people doing the work: recognising excellence in telehealth, digital health, innovation,
          partnerships and healthcare leadership, and crowning the winners of the Student Innovation Challenge.
        </p>
        <a class="btn btn--gold" href="#tickets"><span class="btn__label">Conference + Awards Night ticket</span><span class="btn__arr" aria-hidden="true">→</span></a>
        <p class="gala__small">Award categories and nominations will be announced on our Instagram.</p>
      </div>
    </section>

    <!-- TICKETS -->
    <section class="tix" id="tickets">
      <div class="tix__lines" aria-hidden="true"></div>
      <div class="wrap">
        <div class="tix__head">
          <h2 class="tix__title">Tickets</h2>
          <p class="tix__note">Booked securely through tix.africa. Prices include booking fees.</p>
        </div>
        <ul class="tix__grid">
          {tickets.map((t) => (
            <li class={`pass ${t.featured ? 'pass--featured' : ''}`}>
              {t.featured && <p class="pass__flag">Full experience</p>}
              <h3 class="pass__name">{t.name}</h3>
              <ul class="pass__includes">
                {t.includes.map((x) => <li>{x}</li>)}
              </ul>
              <p class="pass__price">{t.price}</p>
              <p class="pass__note">{t.note}</p>
              <a class="btn btn--block" href={event.ticketUrl} target="_blank" rel="noopener"><span class="btn__label">Get tickets</span><span class="btn__arr" aria-hidden="true">→</span></a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- PARTNERS -->
    <section class="partners" id="partners">
      <div class="wrap">
        <div class="section__head">
          <div>
            <p class="eyebrow">Partners</p>
            <h2 class="display">Put your name behind nationwide telehealth.</h2>
          </div>
          <p class="section__note">
            NTC 2.0 brings together the people who decide how care reaches Nigerians. Partner with us to be in the room,
            on stage and in the conversation.
          </p>
        </div>

        <p class="convened">
          <span>Convened by</span>
          {[partners.convener, ...(partners.coConveners || [])].map((c) => (
            <span class="convened__org">
              {c.logo ? <img src={c.logo} alt={c.name} height="44" /> : <strong>{c.name}</strong>}
              {c.role && <em>{c.role}</em>}
            </span>
          ))}
        </p>

        {filledTiers.length ? (
          <div class="tierwall">
            {filledTiers.map((t) => (
              <div class={`tier tier--${t.id}`}>
                <p class="tier__label">{t.label}</p>
                <ul class="tier__logos">
                  {t.logos.map((l) => (
                    <li>
                      <a class="logo-tile" href={l.url || undefined} target="_blank" rel="noopener" title={l.name}>
                        <img src={l.logo} alt={l.name} loading="lazy" />
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        ) : (
          <ul class="slots">
            {openTiers.map((t) => (
              <li class={`slot slot--${t.id}`}>
                <p class="slot__status"><span class="slot__dot" aria-hidden="true"></span>Open</p>
                <h3 class="slot__tier">{t.label}</h3>
                <p class="slot__blurb">{t.blurb}</p>
                <div class="slot__logo" aria-hidden="true"><span>Your logo here</span></div>
              </li>
            ))}
          </ul>
        )}

        <div class="moments">
          <div class="moments__head">
            <h3 class="moments__title">Where partners show up on the day</h3>
            <p class="moments__sub">Tuesday 20 October · from registration to the last award</p>
          </div>
          <ol class="moments__track">
            {partnerMoments.map((m) => (
              <li class="moment">
                <span class="moment__dot" aria-hidden="true"></span>
                <p class="moment__time">{m.time}</p>
                <h4 class="moment__title">{m.title}</h4>
                <p class="moment__text">{m.text}</p>
              </li>
            ))}
          </ol>
        </div>

        <div class="reach">
          <div class="reach__who">
            <p class="reach__label">Who's in the room</p>
            <ul class="tags">
              {audiences.map((a) => <li>{a}</li>)}
            </ul>
          </div>
          <div class="reach__cta">
            <h3 class="reach__h">Let's talk</h3>
            <p>Tell us what you want to achieve and we'll send the partnership options that fit.</p>
            <a class="btn" href={`mailto:${contact.partnerships}?subject=NTC%202.0%20partnership`}><span class="btn__label">Email the partnerships team</span><span class="btn__arr" aria-hidden="true">→</span></a>
            <p class="reach__contact">{contact.partnerships} · <a href={contact.phoneHref}>{contact.phone}</a></p>
          </div>
        </div>
      </div>
    </section>

    <!-- VENUE -->
    <section class="venue-world" id="venue">
      <div class="wrap venue">
        <div>
          <h2 class="venue__title">See you<br />in Abuja.</h2>
          <p class="venue__name">{event.venue.name}</p>
          <p class="venue__addr">{event.venue.address}</p>
          <a class="btn btn--white" href={event.venue.mapUrl} target="_blank" rel="noopener"><span class="btn__label">Open in Google Maps</span><span class="btn__arr" aria-hidden="true">→</span></a>
        </div>
        <dl class="venue__facts">
          <div><dt>Date</dt><dd>{event.dateLabel}</dd></div>
          <div><dt>Registration opens</dt><dd>7:30 AM</dd></div>
          <div><dt>Conference</dt><dd>{event.conferenceHours}</dd></div>
          <div><dt>Gala & Awards Night</dt><dd>{event.galaHours}</dd></div>
        </dl>
      </div>
    </section>

    <!-- FAQ -->
    <section class="faq-world" id="faq">
      <div class="wrap faq">
        <h2 class="display">Good<br />to know</h2>
        <div class="faq__list">
          {faqs.map((f) => (
            <details>
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>
  </main>

  <footer class="footer">
    <div class="wrap footer__grid">
      <div>
        <a href="#top" class="mark" aria-label="Back to top">
          <svg class="mark__signal" viewBox="0 0 24 16" aria-hidden="true">
            <path d="M3 9a13 13 0 0 1 18 0M7 12.5a7.5 7.5 0 0 1 10 0" />
            <circle cx="12" cy="14.6" r="1.6" />
          </svg>
          <span class="mark__ntc">NTC</span><span class="mark__ver">2.0</span>
        </a>
        <p class="footer__tag">{event.tagline}</p>
        <p class="footer__small">Convened by Mobihealth International.</p>
      </div>
      <div>
        <h3 class="footer__h">Contact</h3>
        <p><a href={contact.phoneHref}>{contact.phone}</a></p>
        <p><a href={`mailto:${contact.support}`}>{contact.support}</a></p>
        <p><a href={`mailto:${contact.partnerships}`}>{contact.partnerships}</a> <span class="footer__small">(partnerships)</span></p>
      </div>
      <div>
        <h3 class="footer__h">Follow</h3>
        {contact.instagram.map((i) => (
          <p><a href={i.url} target="_blank" rel="noopener">{i.handle}</a></p>
        ))}
        <p class="footer__small">{contact.hashtags.join('  ')}</p>
      </div>
    </div>
    <p class="footer__giant" aria-hidden="true">Click &amp; Brick</p>
  </footer>

  <DesignSwitch current="a" />

  <a class="float-cta" href="#tickets"><span class="float-cta__icon" aria-hidden="true">✦</span>Get tickets</a>

  <script>
    import '../scripts/motion.js';
  </script>
</Base>
